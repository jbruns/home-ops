# Repo-root .env: client-side Host access and Repo Tooling config.
# Copy to .env (gitignored) and fill in. Never commit .env.
# Consumers: hops = the hops CLI, Repo Tooling in tools/hops (#616);
# agents = agent sessions reaching the Host directly (e.g. docs/research/0552-unix-identities.md).
# Secrets a Stack needs belong in SOPS under tn/<stack>/, not here.

# Host address (name or IP) for SSH. Read by: hops, agents.
TRUENAS_HOST=

# TrueNAS web UI base URL, e.g. https://truenas.example. hops reaches the TrueNAS API at
# wss://<its host>/api/current (JSON-RPC; never the REST API /api/v2.0). Read by: hops.
TRUENAS_URL=

# TrueNAS API key of the homeops-agent user, scoped by its privilege roles READONLY_ADMIN,
# SNAPSHOT_WRITE and SNAPSHOT_DELETE. Read by: hops (sent only in the login message).
HOPS_TRUENAS_API_KEY=

# Being retired: a full-admin TrueNAS API key. Nothing reads it; use HOPS_TRUENAS_API_KEY.
TRUENAS_API_KEY=

# Optional. Set to 1 to skip TLS verification for a self-signed TrueNAS certificate. Read by: hops.
# HOPS_TRUENAS_INSECURE=1

# Optional. SSH user on the Host. Read by: hops. Default: homeops-agent.
# HOPS_SSH_USER=homeops-agent

# Optional. SSH private key for HOPS_SSH_USER. Read by: hops. Default: ~/.ssh/homeops_agent_ed25519.
# HOPS_SSH_KEY=~/.ssh/homeops_agent_ed25519
