# Repo-root .env: client-side Host access and Repo Tooling config.
# Copy to .env (gitignored) and fill in. Never commit .env.
# Consumers: hops = tools/hops (#616); agents = ad-hoc agent access to the Host.
# Secrets a Stack needs belong in SOPS under tn/<stack>/, not here.

# Host address (name or IP) for SSH. Read by: hops, agents.
TRUENAS_HOST=

# TrueNAS web UI and API base URL, e.g. https://truenas.example. Read by: agents (read-only API GET calls).
TRUENAS_URL=

# TrueNAS API key. Read by: agents (read-only API GET calls).
TRUENAS_API_KEY=

# Optional. SSH user on the Host. Read by: hops. Default: homeops-agent.
# HOPS_SSH_USER=homeops-agent

# Optional. SSH private key for HOPS_SSH_USER. Read by: hops. Default: ~/.ssh/homeops_agent_ed25519.
# HOPS_SSH_KEY=~/.ssh/homeops_agent_ed25519
