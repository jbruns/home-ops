# Repo-root .env: client-side Host access and Repo Tooling config.
# Copy to .env (gitignored) and fill in. Never commit .env.
# Keys are per Host in hosts.yaml, prefixed HOPS_<NAME>_ (Host truenas: HOPS_TRUENAS_; Host proxmox: HOPS_PROXMOX_).
# Consumers: hops = the hops CLI, shared Repo Tooling from the Repo Tooling repo
# (".env" in its README, repo-tools/hops/README.md);
# agents = agent sessions reaching the Host directly (e.g. docs/research/0552-unix-identities.md).
# Secrets a Stack needs belong in SOPS under tn/<stack>/, not here.

# --- The TrueNAS Host (truenas) ---

# Host address (name or IP) for SSH. Read by: hops, agents.
HOPS_TRUENAS_SSH_HOST=

# SSH user on the Host, the agent's own login; it needs passwordless `sudo -n docker` and `sudo -n midclt`
# (ADR 0015). Read by: hops (docker only), agents.
HOPS_TRUENAS_SSH_USER=

# SSH private key for HOPS_TRUENAS_SSH_USER. Read by: hops. Unset, ssh picks one.
HOPS_TRUENAS_SSH_KEY=~/.ssh/homeops_agent_ed25519

# TrueNAS web UI base URL, e.g. https://truenas.example. hops reaches the TrueNAS API at
# wss://<its host>/api/current (JSON-RPC; never the REST API /api/v2.0). Read by: hops.
HOPS_TRUENAS_TRUENAS_URL=

# TrueNAS API key of the HOPS_TRUENAS_SSH_USER user, scoped by its privilege roles READONLY_ADMIN,
# SNAPSHOT_WRITE and SNAPSHOT_DELETE. Read by: hops (sent only in the login message).
HOPS_TRUENAS_TRUENAS_API_KEY=

# Optional. 1/true/yes/on skips TLS verification for a self-signed TrueNAS certificate. Read by: hops.
# HOPS_TRUENAS_TRUENAS_INSECURE=1

# Optional. Dataset names, comma- or space-separated, that `hops host` also reports. Read by: hops.
# HOPS_TRUENAS_HOST_DATASETS=

# --- The Proxmox Host (proxmox) ---
# tools/proxmox-access/grant-access.sh writes these keys (ADR 0019).

# Host address (name or IP) for SSH. Read by: hops, agents.
HOPS_PROXMOX_SSH_HOST=

# SSH user on the Host, the agent's own login; its `sudo -n` allows only pvesh, qm, pct, vzdump and tee to the
# idmap files, Guest configs and snippets (writes only, ADR 0019). Read by: hops (`apt list --upgradable`
# without sudo, for pending updates), agents.
HOPS_PROXMOX_SSH_USER=

# SSH private key for HOPS_PROXMOX_SSH_USER. Read by: hops, agents. Unset, ssh picks one.
HOPS_PROXMOX_SSH_KEY=~/.ssh/homeops_agent_ed25519

# Proxmox VE API base URL, https://<host>:8006 (no path). Read by: hops.
HOPS_PROXMOX_PROXMOX_URL=

# API token ID, user@realm!name, of the audit-only token: privilege-separated, PVEAuditor on / only.
# Read by: hops.
HOPS_PROXMOX_PROXMOX_TOKEN_ID=hops-reader@pve!hops

# That token's secret. Read by: hops (sent only in the Authorization header).
HOPS_PROXMOX_PROXMOX_TOKEN_SECRET=

# Optional. 1/true/yes/on skips TLS verification for the Host's self-signed certificate. Read by: hops.
# HOPS_PROXMOX_PROXMOX_INSECURE=1

# --- Immich (tools/photo-migrate) ---
# API keys of the two household accounts in tn/immich: the Operator's, then the second household member's. Each is
# created by its own user with the permissions user.read, asset.upload, album.read, album.create, albumAsset.create
# and albumUser.create. Read by: tools/photo-migrate (sent to the Host on the upload container's stdin, never in a
# command line).
IMMICH_API_KEY_OPERATOR=
IMMICH_API_KEY_MEMBER=
