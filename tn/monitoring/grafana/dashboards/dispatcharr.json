{
  "uid": "dispatcharr",
  "title": "Dispatcharr",
  "description": "Dispatcharr live channels, ffmpeg speed, providers and container (exporter plugin, remote Prometheus).",
  "tags": [
    "home-ops"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "home-ops"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max(service:uptime:ok{container=\"dispatcharr\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Dispatcharr's Uptime now, from its machine's Probe.",
      "id": 2
    },
    {
      "type": "stat",
      "title": "Exporter",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max(up{job=\"dispatcharr\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 3,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "The exporter plugin's scrape. Down means every panel below is blank (TargetDown alerts).",
      "id": 3
    },
    {
      "type": "stat",
      "title": "Live channels",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max(dispatcharr_active_streams{type=\"live\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Channels Dispatcharr is pulling from a provider.",
      "id": 4
    },
    {
      "type": "stat",
      "title": "Clients",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "sum(dispatcharr_stream_active_clients{type=\"live\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Buffering",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "count(dispatcharr_stream_metadata{type=\"live\", state=\"buffering\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "DispatcharrChannelBuffering alerts after 3 minutes.",
      "id": 6
    },
    {
      "type": "stat",
      "title": "Slow (< 0.95x)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "count(dispatcharr_stream_buffering_speed{type=\"live\"} < 0.95) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 15,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "ffmpeg reading slower than real time. DispatcharrChannelSlow alerts after 5 minutes.",
      "id": 7
    },
    {
      "type": "stat",
      "title": "On failover",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "count(dispatcharr_stream_index{type=\"live\"} > 0) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Channels playing a backup source, not their first.",
      "id": 8
    },
    {
      "type": "stat",
      "title": "Provider connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "sum(dispatcharr_profile_connections)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 3,
        "h": 4,
        "x": 21,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Upstream connections in use across M3U accounts; limits are in Providers below.",
      "id": 9
    },
    {
      "type": "row",
      "title": "Channels",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 5
      },
      "id": 10
    },
    {
      "type": "table",
      "title": "Live channels",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid, channel_number, channel_name, channel_group, state, stream_profile, provider) (dispatcharr_stream_metadata{type=\"live\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid) (dispatcharr_stream_buffering_speed{type=\"live\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid) (dispatcharr_stream_current_bitrate_bps{type=\"live\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid) (dispatcharr_stream_active_clients{type=\"live\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid) (dispatcharr_stream_uptime_seconds{type=\"live\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid) (dispatcharr_stream_index{type=\"live\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "w": 24,
        "h": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "channel_uuid"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "n"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Speed"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Bitrate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "active": {
                        "color": "green",
                        "index": 0
                      },
                      "waiting_for_clients": {
                        "color": "blue",
                        "index": 1
                      },
                      "buffering": {
                        "color": "orange",
                        "index": 2
                      },
                      "stopping": {
                        "color": "text",
                        "index": 3
                      },
                      "error": {
                        "color": "red",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "channel_number",
            "desc": false
          }
        ]
      },
      "description": "Source 0 is the channel's first stream; higher means failover.",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "channel_uuid",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time 9": true
            },
            "renameByName": {
              "Value #A": "n",
              "Value #B": "Speed",
              "Value #C": "Bitrate",
              "Value #D": "Clients",
              "Value #E": "Up for",
              "Value #F": "Source"
            },
            "indexByName": {
              "channel_uuid": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6
            }
          }
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "ffmpeg speed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid, channel_number) (dispatcharr_stream_buffering_speed{type=\"live\"}) * on (channel_uuid) group_left (channel_name) max by (channel_uuid, channel_name) (dispatcharr_stream_metadata{type=\"live\"})",
          "legendFormat": "{{channel_number}} {{channel_name}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Read speed against real time (1.0). Below 0.95 for 5 minutes alerts. ffmpeg profiles only.",
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Bitrate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_uuid, channel_number) (dispatcharr_stream_current_bitrate_bps{type=\"live\"}) * on (channel_uuid) group_left (channel_name) max by (channel_uuid, channel_name) (dispatcharr_stream_metadata{type=\"live\"})",
          "legendFormat": "{{channel_number}} {{channel_name}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13
    },
    {
      "type": "state-timeline",
      "title": "Channel state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (channel_name) (dispatcharr_stream_metadata{type=\"live\", state=\"active\"} * 1 or dispatcharr_stream_metadata{type=\"live\", state=\"waiting_for_clients\"} * 2 or dispatcharr_stream_metadata{type=\"live\", state=\"buffering\"} * 3 or dispatcharr_stream_metadata{type=\"live\", state=\"stopping\"} * 4 or dispatcharr_stream_metadata{type=\"live\", state=\"error\"} * 5)",
          "legendFormat": "{{channel_name}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ACTIVE",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "WAITING FOR CLIENTS",
                  "color": "blue",
                  "index": 1
                },
                "3": {
                  "text": "BUFFERING",
                  "color": "orange",
                  "index": 2
                },
                "4": {
                  "text": "STOPPING",
                  "color": "text",
                  "index": 3
                },
                "5": {
                  "text": "ERROR",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Streams and clients",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (type) (dispatcharr_active_streams{type!=\"\"})",
          "legendFormat": "{{type}} streams"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
