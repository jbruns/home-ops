        }
      },
      "id": 9
    },
    {
      "type": "row",
      "title": "nzbhydra2 indexers (nzbhydra2's own Prometheus)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 39
      },
      "id": 10
    },
    {
      "type": "state-timeline",
      "title": "Indexer state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "sum by (indexer) (nzbhydra2_indexer_state{state=\"ENABLED\"} * 1 or nzbhydra2_indexer_state{state=\"DISABLED_SYSTEM\"} * -1 or nzbhydra2_indexer_state{state=\"DISABLED_USER\"} * 2)",
          "legendFormat": "{{indexer}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ENABLED",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "BACKOFF",
                  "color": "orange",
                  "index": 1
                },
                "-1": {
                  "text": "DISABLED",
                  "color": "red",
                  "index": 2
                },
                "2": {
                  "text": "OFF (user)",
                  "color": "text",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "description": "BACKOFF is nzbhydra2's temporary disable after errors. Gaps mean its machine is unreachable.",
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Indexer API hits",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (indexer) (nzbhydra2_indexer_api_hits)",
          "legendFormat": "{{indexer}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Every indexer, with or without a daily limit. Counts reset at midnight.",
      "id": 12
    },
    {
      "type": "bargauge",
      "title": "Daily allowance used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-remote"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (indexer) (nzbhydra2_indexer_api_hits / nzbhydra2_indexer_api_hit_limit)",
          "legendFormat": "{{indexer}} API",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-remote"
          },
          "expr": "max by (indexer) (nzbhydra2_indexer_download_hits / nzbhydra2_indexer_download_hit_limit)",
          "legendFormat": "{{indexer}} downloads",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Hits as a share of each daily limit configured in nzbhydra2; indexers without one are not shown. NzbhydraIndexerLimitNear alerts above 90% for 15 minutes. Counts reset at midnight.",
      "id": 13
    },
