        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "description": "UP = active in sabnzbd with no error.",
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (server) (sabnzbd_usenet_server_connections)",
          "legendFormat": "{{server}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 6,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
