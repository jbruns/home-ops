{
  "uid": "dependencies",
  "title": "Dependency map",
  "description": "Internal and External Dependencies: the map, Dependency Probes, Usenet providers and indexers.",
  "tags": [
    "home-ops"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "home-ops"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Map",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "nodeGraph",
      "title": "Dependency map",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace((max by (id, title, subtitle) (label_replace(\n  label_replace(label_replace(max by (container) (service:uptime:ok) and on (container) (group by (container) (label_replace(group by (from) (probe_success{job=\"dependency\"}), \"container\", \"$1\", \"from\", \"(.+)\")) or group by (container) (label_replace(group by (to) (probe_success{job=\"dependency\", kind=\"internal\"}), \"container\", \"$1\", \"to\", \"(.+)\"))), \"id\", \"$1\", \"container\", \"(.+)\"), \"subtitle\", \"Service\", \"\", \"\")\n  or label_replace(label_replace(min by (to) (probe_success{job=\"dependency\", kind=\"external\"}), \"id\", \"$1\", \"to\", \"(.+)\"), \"subtitle\", \"External Dependency\", \"\", \"\")\n  or label_replace(label_replace(max by (server) ((sabnzbd_usenet_server_error == bool 0) and on (server) (sabnzbd_usenet_server_active == 1)), \"id\", \"$1\", \"server\", \"(.+)\"), \"subtitle\", \"Usenet provider\", \"\", \"\"),\n  \"title\", \"$1\", \"id\", \"(.+)\"))) == 1, \"mainstat\", \"UP\", \"\", \"\"), \"color\", \"#73BF69\", \"\", \"\") or label_replace(label_replace((max by (id, title, subtitle) (label_replace(\n  label_replace(label_replace(max by (container) (service:uptime:ok) and on (container) (group by (container) (label_replace(group by (from) (probe_success{job=\"dependency\"}), \"container\", \"$1\", \"from\", \"(.+)\")) or group by (container) (label_replace(group by (to) (probe_success{job=\"dependency\", kind=\"internal\"}), \"container\", \"$1\", \"to\", \"(.+)\"))), \"id\", \"$1\", \"container\", \"(.+)\"), \"subtitle\", \"Service\", \"\", \"\")\n  or label_replace(label_replace(min by (to) (probe_success{job=\"dependency\", kind=\"external\"}), \"id\", \"$1\", \"to\", \"(.+)\"), \"subtitle\", \"External Dependency\", \"\", \"\")\n  or label_replace(label_replace(max by (server) ((sabnzbd_usenet_server_error == bool 0) and on (server) (sabnzbd_usenet_server_active == 1)), \"id\", \"$1\", \"server\", \"(.+)\"), \"subtitle\", \"Usenet provider\", \"\", \"\"),\n  \"title\", \"$1\", \"id\", \"(.+)\"))) == 0, \"mainstat\", \"DOWN\", \"\", \"\"), \"color\", \"#F2495C\", \"\", \"\")",
          "legendFormat": "",
          "instant": true,
          "range": false
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace((max by (id, source, target) (\n  label_join(label_replace(label_replace(min by (from, to) (probe_success{job=\"dependency\"}), \"target\", \"$1\", \"to\", \"(.+)\"), \"source\", \"$1\", \"from\", \"(.+)\"), \"id\", \" -> \", \"source\", \"target\")\n  or label_join(label_replace(label_replace(max by (server) ((sabnzbd_usenet_server_error == bool 0) and on (server) (sabnzbd_usenet_server_active == 1)), \"target\", \"$1\", \"server\", \"(.+)\"), \"source\", \"sabnzbd\", \"\", \"\"), \"id\", \" -> \", \"source\", \"target\")\n)) == 1, \"mainstat\", \"UP\", \"\", \"\"), \"color\", \"#73BF69\", \"\", \"\") or label_replace(label_replace((max by (id, source, target) (\n  label_join(label_replace(label_replace(min by (from, to) (probe_success{job=\"dependency\"}), \"target\", \"$1\", \"to\", \"(.+)\"), \"source\", \"$1\", \"from\", \"(.+)\"), \"id\", \" -> \", \"source\", \"target\")\n  or label_join(label_replace(label_replace(max by (server) ((sabnzbd_usenet_server_error == bool 0) and on (server) (sabnzbd_usenet_server_active == 1)), \"target\", \"$1\", \"server\", \"(.+)\"), \"source\", \"sabnzbd\", \"\", \"\"), \"id\", \" -> \", \"source\", \"target\")\n)) == 0, \"mainstat\", \"DOWN\", \"\", \"\"), \"color\", \"#F2495C\", \"\", \"\")",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "w": 24,
        "h": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "layoutAlgorithm": "layered",
        "zoomMode": "cooperative"
      },
      "description": "Services with Dependency Probes, their Dependencies, and sabnzbd's Usenet providers. Services show Uptime; External Dependencies show their worst Dependency Probe; edges show the Dependency Probe (providers: active and no error in sabnzbd).",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {},
          "filter": {
            "id": "byRefId",
            "options": "nodes"
          }
        },
        {
          "id": "merge",
          "options": {},
          "filter": {
            "id": "byRefId",
            "options": "edges"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            }
          }
        }
      ],
      "id": 2
    },
    {
      "type": "row",
      "title": "Dependency Probes",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 17
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Dependency Probes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance, from, to, kind) (probe_success{job=\"dependency\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (probe_duration_seconds{job=\"dependency\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time 9": true
            },
            "renameByName": {
              "Value #A": "Up",
              "Value #B": "Duration"
            },
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        }
      ],
      "id": 4
    },
    {
      "type": "state-timeline",
      "title": "Dependency Probes over time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (instance) (probe_success{job=\"dependency\"})",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 7,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Dependency Probe duration",
      "datasource": {
        "type": "prometheus",
