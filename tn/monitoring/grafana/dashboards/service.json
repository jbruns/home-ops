    {
      "type": "logs",
      "title": "4xx from home addresses",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"traefik\", logstream=\"access\", client=\"home\"} | json | DownstreamStatus >= 400 and DownstreamStatus < 500 and RouterName =~ \"$container-(https?|health|client-[a-z0-9]+)@.+\" and request_User_Agent !~ \"Blackbox-Exporter/.*\" | line_format \"{{.DownstreamStatus}} {{.RequestMethod}} {{.RequestPath}} via {{.RouterName}} ({{.request_User_Agent}})\"",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 16,
        "h": 10,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "description": "A home user's failures, from the home public addresses (the CrowdSec whitelist; Alloy labels them client=home). Probes are excluded. Client IPs are only in the access log, never in metrics.",
      "id": 18
    },
    {
      "type": "timeseries",
      "title": "CrowdSec decisions in effect",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
