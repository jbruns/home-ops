// Ships every container's logs to Loki, read through the Docker API.
// Labels: container, stack (Compose project), service (Compose service), tier, logstream.
// The `stack` label comes from Compose itself, so a new Service needs no opt-in label.
// Also tails Traefik's access log (logstream=access, plus client=home from the home public
// addresses). Both redact keys and tokens in URLs. Nextcloud's lines lose PHP's error_log prefix.

discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "15s"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "stack"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_tier"]
		target_label  = "tier"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "logstream"
	}
}

loki.source.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.docker.containers.targets
	relabel_rules    = discovery.relabel.containers.rules
	refresh_interval = "15s"
	forward_to       = [loki.process.containers.receiver]
}

// Container logs can quote a URL with its key too: blackbox logs a failed Probe's target
// (Dependency Probes carry API keys, prometheus/dependencies.yaml).
loki.process "containers" {
	stage.replace {
		expression = "(?i)(?:api_?key|apikey|nzbkey|token|x-plex-token|access_token)=([^&\"\\s]+)"
		replace    = "REDACTED"
	}

	// Nextcloud logs through PHP's error_log (nextcloud/service.yaml), which prefixes each entry with
	// "[date] [nextcloud][app][level] ". Drop that so the line is Nextcloud's JSON: | json | level >= 3.
	stage.match {
		selector = "{stack=\"nextcloud\", service=~\"nextcloud|nextcloud-cron\"}"

		stage.replace {
			expression = "^(\\[[^\\]]*\\] \\[nextcloud\\]\\[[^\\]]*\\]\\[[0-9]\\] )\\{"
			replace    = ""
		}
	}

	forward_to = [loki.write.local.receiver]
}

// Traefik's JSON access log. Only access.log: the rotated .1/.2 copies would ship twice.
// The tailer follows the daily copytruncate.
loki.source.file "traefik_access" {
	targets = [{
		__path__  = "/var/log/traefik/access.log",
		container = "traefik",
		stack     = "edge",
		service   = "traefik",
		tier      = "critical",
		logstream = "access",
	}]
	tail_from_end = true
	forward_to    = [loki.process.traefik_access.receiver]
}

loki.process "traefik_access" {
	// Some clients put API keys and tokens in the query string; keep them out of Loki.
	stage.replace {
		expression = "(?i)(?:api_?key|apikey|nzbkey|token|x-plex-token|access_token)=([^&\"\\s]+)"
		replace    = "REDACTED"
	}

	stage.json {
		expressions = {start = "StartUTC"}
	}

	stage.timestamp {
		source = "start"
		format = "RFC3339Nano"
	}

	// client="home" marks requests from the home public addresses (the CrowdSec whitelist), so
	// a home user's 4xx can be told from Internet noise. The repo is public, so the addresses
	// come from home-clients.sops.env as a regex over ClientHost; keep it in step with
	// tn/edge/crowdsec/home-whitelist.sops.yaml. stage.match has no LogQL ip() filter, and its
	// selector takes no raw strings, so the regex has no backslashes or quotes (`[.]` for a dot).
	stage.match {
		selector = "{logstream=\"access\"} |~ \"\\\"ClientHost\\\":\\\"(?:" + sys.env("HOME_CLIENT_REGEX") + ")\\\"\""

		stage.static_labels {
			values = {client = "home"}
		}
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
