#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCK_FILE="${AGENT_SKILLS_LOCK:-$REPO_ROOT/.agent-skills.lock}"
SKILLS_DIR="$REPO_ROOT/.agents/skills"
STATE_FILE="$SKILLS_DIR/.agent-skills-managed"

source_url=""
source_ref=""
source_revision=""
# The installed set is the source's published manifest, minus `exclude`
# entries, plus `include` entries; it is resolved at setup time.
MANIFEST_PATH=".claude-plugin/plugin.json"
includes=()
excludes=()
skills=()
skills_count=0

die() {
    echo "error: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: scripts/setup-agent-skills [setup|check|clean]
       scripts/setup-agent-skills pin <ref>

  setup  Install the repository's pinned skills (default).
  check  Verify that the local installation matches .agent-skills.lock.
  clean  Remove only the skills managed by this helper.
  pin    Resolve a new source ref, update the lock, and install it.

Requires Bash 3.2+, Git with sparse-checkout support, and Python 3.
Set AGENT_SKILLS_LOCK to use an alternate lock file.
EOF
}

# Skill paths name a directory relative to the source's skills/ tree,
# e.g. "tdd" or "engineering/tdd". Skills install flat by their final segment.
validate_skill_path() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$ ]] ||
        die "invalid skill path: $1"
}

contains() {
    local needle="$1" item
    shift
    for item in "$@"; do
        [ "$item" != "$needle" ] || return 0
    done
    return 1
}

skill_name() {
    printf '%s\n' "${1##*/}"
}

load_lock() {
    [ -f "$LOCK_FILE" ] || die "missing lock file: $LOCK_FILE"

    local line_number=0 key value extra
    while read -r key value extra || [ -n "${key:-}" ]; do
        line_number=$((line_number + 1))
        case "${key:-}" in
            ""|\#*) continue ;;
        esac

        [ -n "${value:-}" ] && [ -z "${extra:-}" ] ||
            die "invalid entry at $LOCK_FILE:$line_number"

        case "$key" in
            source)
                [ -z "$source_url" ] || die "duplicate source in $LOCK_FILE"
                source_url="$value"
                ;;
            ref)
                [ -z "$source_ref" ] || die "duplicate ref in $LOCK_FILE"
                source_ref="$value"
                ;;
            revision)
                [ -z "$source_revision" ] || die "duplicate revision in $LOCK_FILE"
                [[ "$value" =~ ^[0-9a-f]{40}$ ]] ||
                    die "revision must be a full lowercase commit SHA"
                source_revision="$value"
                ;;
            include)
                validate_skill_path "$value"
                ! contains "$value" ${includes[@]+"${includes[@]}"} ||
                    die "duplicate include '$value' in $LOCK_FILE"
                includes+=("$value")
                ;;
            exclude)
                # A bare name excludes that skill from any category.
                validate_skill_path "$value"
                ! contains "$value" ${excludes[@]+"${excludes[@]}"} ||
                    die "duplicate exclude '$value' in $LOCK_FILE"
                excludes+=("$value")
                ;;
            skill)
                die "'skill' entries were replaced by the source manifest; use include/exclude ($LOCK_FILE:$line_number)"
                ;;
            *)
                die "unknown key '$key' at $LOCK_FILE:$line_number"
                ;;
        esac
    done <"$LOCK_FILE"

    [ -n "$source_url" ] || die "lock file has no source"
    [ -n "$source_ref" ] || die "lock file has no ref"
    [ -n "$source_revision" ] || die "lock file has no revision"

    local entry
    for entry in ${includes[@]+"${includes[@]}"}; do
        ! is_excluded "$entry" || die "'$entry' is both included and excluded in $LOCK_FILE"
    done
}

is_excluded() {
    local skill="$1" entry
    for entry in ${excludes[@]+"${excludes[@]}"}; do
        if [[ "$entry" == */* ]]; then
            [ "$entry" != "$skill" ] || return 0
        else
            [ "$entry" != "$(skill_name "$skill")" ] || return 0
        fi
    done
    return 1
}

# Prints the skill paths listed in the source manifest's "skills" array, e.g.
# "./skills/engineering/tdd" -> "engineering/tdd". A missing manifest lists nothing.
manifest_skills() {
    local checkout="$1" manifest
    git -C "$checkout" cat-file -e "FETCH_HEAD:$MANIFEST_PATH" 2>/dev/null || return 0
    manifest="$(git -C "$checkout" show "FETCH_HEAD:$MANIFEST_PATH")" ||
        die "cannot read $MANIFEST_PATH"
    printf '%s' "$manifest" | python3 -c '
import json
import re
import sys

try:
    manifest = json.load(sys.stdin)
except ValueError as error:
    sys.exit(f"error: invalid source manifest: {error}")
if not isinstance(manifest, dict):
    sys.exit("error: source manifest must be a JSON object")
skills = manifest.get("skills", [])
if not isinstance(skills, list):
    sys.exit("error: source manifest skills must be an array")
for path in skills:
    if not isinstance(path, str):
        sys.exit("error: source manifest skill paths must be strings")
    if path.startswith("./"):
        path = path[2:]
    if not path.startswith("skills/"):
        sys.exit(f"error: source manifest skill path must be under skills/: {path}")
    path = path[len("skills/"):].rstrip("/")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*", path):
        sys.exit(f"error: invalid source manifest skill path: {path!r}")
    print(path)
'
}

# Resolves the installed set: manifest minus excludes, plus includes.
resolve_skills() {
    local checkout="$1" skill entry found manifest_paths
    local listed=()
    manifest_paths="$(manifest_skills "$checkout")" || die "cannot resolve source manifest"
    while IFS= read -r skill; do
        [ -n "$skill" ] || continue
        validate_skill_path "$skill"
        listed+=("$skill")
    done <<<"$manifest_paths"

    skills=()
    skills_count=0
    for skill in ${listed[@]+"${listed[@]}"} ${includes[@]+"${includes[@]}"}; do
        ! is_excluded "$skill" || continue
        contains "$skill" ${skills[@]+"${skills[@]}"} && continue
        for entry in ${skills[@]+"${skills[@]}"}; do
            [ "$(skill_name "$entry")" != "$(skill_name "$skill")" ] ||
                die "'$entry' and '$skill' would both install as '$(skill_name "$skill")'"
        done
        skills+=("$skill")
        skills_count=$((skills_count + 1))
    done

    for entry in ${excludes[@]+"${excludes[@]}"}; do
        found=0
        for skill in ${listed[@]+"${listed[@]}"}; do
            if [[ "$entry" == */* ]]; then
                [ "$entry" != "$skill" ] || found=1
            else
                [ "$entry" != "$(skill_name "$skill")" ] || found=1
            fi
        done
        [ "$found" -eq 1 ] ||
            echo "warning: exclude '$entry' matches no skill in the source manifest at $source_ref" >&2
    done

    [ "$skills_count" -gt 0 ] ||
        die "no skills to install: $source_ref has no $MANIFEST_PATH entries and the lock has no includes"
}

# The lock settings a resolved installation was made from.
write_lock_state() {
    local entry
    printf 'source %s\n' "$source_url"
    printf 'ref %s\n' "$source_ref"
    printf 'revision %s\n' "$source_revision"
    for entry in ${includes[@]+"${includes[@]}"}; do
        printf 'include %s\n' "$entry"
    done | LC_ALL=C sort
    for entry in ${excludes[@]+"${excludes[@]}"}; do
        printf 'exclude %s\n' "$entry"
    done | LC_ALL=C sort
}

hash_installed_skill() (
    local skill="$1" index_file
    index_file="$(mktemp "${TMPDIR:-/tmp}/agent-skills-index.XXXXXX")"
    rm -f "$index_file"
    trap 'rm -f "$index_file"' EXIT

    GIT_INDEX_FILE="$index_file" git -C "$REPO_ROOT" read-tree --empty
    GIT_INDEX_FILE="$index_file" git -C "$REPO_ROOT" add -f -- ".agents/skills/$skill"
    GIT_INDEX_FILE="$index_file" git -C "$REPO_ROOT" write-tree
)

state_manages_skill() {
    local skill="$1"
    awk -v skill="$skill" '
        $1 == "skill" && (NF == 2 || NF == 3) {
            n = split($2, parts, "/")
            if (parts[n] == skill) found = 1
        }
        END { exit !found }
    ' "$STATE_FILE"
}

write_installed_state() {
    local output="$1" skill
    {
        write_lock_state
        for skill in "${skills[@]}"; do
            printf 'skill %s %s\n' "$skill" "$(hash_installed_skill "$(skill_name "$skill")")"
        done
    } >"$output"
}

# Offline: the lock must match what the installation was resolved from, and
# every skill recorded at install time must be unchanged on disk.
check_installation() (
    local expected actual_metadata key skill expected_hash extra name actual_hash
    expected="$(mktemp "${TMPDIR:-/tmp}/agent-skills-state.XXXXXX")"
    actual_metadata="$(mktemp "${TMPDIR:-/tmp}/agent-skills-state.XXXXXX")"
    trap 'rm -f "$expected" "$actual_metadata"' EXIT
    write_lock_state >"$expected"

    [ -f "$STATE_FILE" ] ||
        die "agent skills are not installed; run scripts/setup-agent-skills"
    awk '$1 != "skill"' "$STATE_FILE" >"$actual_metadata"
    cmp -s "$expected" "$actual_metadata" ||
        die "agent skills are stale; run scripts/setup-agent-skills"

    skills_count=0
    while read -r key skill expected_hash extra; do
        [ "$key" = "skill" ] || continue
        [ -z "${extra:-}" ] && [[ "${expected_hash:-}" =~ ^[0-9a-f]{40}$ ]] ||
            die "invalid installed state for '$skill'; run scripts/setup-agent-skills"
        validate_skill_path "$skill"
        name="$(skill_name "$skill")"
        [ -f "$SKILLS_DIR/$name/SKILL.md" ] ||
            die "missing installed skill '$name'; run scripts/setup-agent-skills"
        actual_hash="$(hash_installed_skill "$name")"
        [ "$actual_hash" = "$expected_hash" ] ||
            die "installed skill '$name' has local changes; run scripts/setup-agent-skills"
        skills_count=$((skills_count + 1))
    done <"$STATE_FILE"
    [ "$skills_count" -gt 0 ] ||
        die "no skills are installed; run scripts/setup-agent-skills"

    echo "Agent skills match $source_ref ($source_revision)."
)

setup_skills() (
    command -v git >/dev/null 2>&1 || die "git is required"
    command -v python3 >/dev/null 2>&1 || die "python3 is required"

    local temp_dir checkout actual_revision skill name path
    temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/agent-skills.XXXXXX")"
    checkout="$temp_dir/source"
    trap 'rm -rf "$temp_dir"' EXIT

    git init --quiet "$checkout"
    git -C "$checkout" remote add origin "$source_url"
    git -C "$checkout" sparse-checkout init --cone
    git -C "$checkout" fetch --quiet --depth 1 --filter=blob:none origin "$source_ref"

    actual_revision="$(git -C "$checkout" rev-parse 'FETCH_HEAD^{commit}')"
    [ "$actual_revision" = "$source_revision" ] ||
        die "$source_ref resolved to $actual_revision, expected $source_revision; update the lock deliberately"

    resolve_skills "$checkout"

    local sparse_paths=()
    for skill in "${skills[@]}"; do
        sparse_paths+=("skills/$skill")
    done
    git -C "$checkout" sparse-checkout set --skip-checks "${sparse_paths[@]}"
    git -C "$checkout" checkout --quiet --detach "$actual_revision"

    for skill in "${skills[@]}"; do
        name="$(skill_name "$skill")"
        [ -f "$checkout/skills/$skill/SKILL.md" ] ||
            die "skill '$skill' does not exist at $source_ref"
        if { [ -e "$SKILLS_DIR/$name" ] || [ -L "$SKILLS_DIR/$name" ]; } &&
            { [ ! -f "$STATE_FILE" ] || ! state_manages_skill "$name"; }; then
            die "$SKILLS_DIR/$name exists but is not managed by this helper"
        fi
    done

    if [ -f "$STATE_FILE" ]; then
        while read -r key skill hash extra; do
            [ "$key" = "skill" ] || continue
            [ -z "${extra:-}" ] || die "invalid managed state: $STATE_FILE"
            validate_skill_path "$skill"
            rm -rf "$SKILLS_DIR/$(skill_name "$skill")"
        done <"$STATE_FILE"
    fi

    mkdir -p "$SKILLS_DIR"
    for skill in "${skills[@]}"; do
        path="$SKILLS_DIR/$(skill_name "$skill")"
        rm -rf "$path"
        cp -R "$checkout/skills/$skill" "$path"
    done

    write_installed_state "$temp_dir/state"
    mv "$temp_dir/state" "$STATE_FILE"
    echo "Installed $skills_count agent skills from $source_ref ($source_revision)."
)

pin_ref() (
    command -v git >/dev/null 2>&1 || die "git is required"

    local new_ref="$1" temp_dir checkout new_revision temp_lock
    [ -n "$new_ref" ] || die "ref must not be empty"
    [[ "$new_ref" != *[[:space:]]* ]] || die "ref must not contain whitespace"

    temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/agent-skills-pin.XXXXXX")"
    checkout="$temp_dir/source"
    temp_lock="$temp_dir/lock"
    trap 'rm -rf "$temp_dir"' EXIT

    git init --quiet "$checkout"
    git -C "$checkout" remote add origin "$source_url"
    git -C "$checkout" fetch --quiet --depth 1 --filter=blob:none origin "$new_ref"
    new_revision="$(git -C "$checkout" rev-parse 'FETCH_HEAD^{commit}')"

    source_ref="$new_ref"
    source_revision="$new_revision"
    setup_skills

    awk -v ref="$new_ref" -v revision="$new_revision" '
        $1 == "ref" { print "ref " ref; next }
        $1 == "revision" { print "revision " revision; next }
        { print }
    ' "$LOCK_FILE" >"$temp_lock"
    chmod 0644 "$temp_lock"
    mv "$temp_lock" "$LOCK_FILE"

    echo "Pinned $new_ref at $new_revision in ${LOCK_FILE#$REPO_ROOT/}."
)

clean_skills() {
    local key skill hash extra
    [ -f "$STATE_FILE" ] || {
        echo "No managed agent skills are installed."
        return
    }

    while read -r key skill hash extra; do
        [ "$key" = "skill" ] || continue
        [ -z "${extra:-}" ] || die "invalid managed state: $STATE_FILE"
        validate_skill_path "$skill"
        rm -rf "$SKILLS_DIR/$(skill_name "$skill")"
    done <"$STATE_FILE"
    rm -f "$STATE_FILE"
    echo "Removed repository-managed agent skills."
}

command_name="${1:-setup}"

case "$command_name" in
    setup)
        [ "$#" -eq 0 ] || [ "$#" -eq 1 ] || {
            usage >&2
            exit 2
        }
        load_lock
        setup_skills
        ;;
    check)
        [ "$#" -eq 1 ] || {
            usage >&2
            exit 2
        }
        load_lock
        check_installation
        ;;
    clean)
        [ "$#" -eq 1 ] || {
            usage >&2
            exit 2
        }
        clean_skills
        ;;
    pin)
        [ "$#" -eq 2 ] || {
            usage >&2
            exit 2
        }
        load_lock
        pin_ref "$2"
        ;;
    -h|--help|help)
        [ "$#" -eq 1 ] || {
            usage >&2
            exit 2
        }
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
