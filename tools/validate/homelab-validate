#!/bin/sh
# homelab-validate with every input in tools/validate/paths named explicitly, so a missing one fails.
# Usage: tools/validate/homelab-validate [homelab-validate args...] [check...]
set -eu
root=$(cd "$(dirname "$0")/../.." && pwd)
# shellcheck disable=SC2046 # one --path NAME=PATH pair per line; paths hold no whitespace
set -- $(sed -e '/^#/d' -e '/^$/d' -e 's/^/--path /' "$root/tools/validate/paths") "$@"
exec homelab-validate --root "$root" "$@"
