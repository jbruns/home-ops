#!/usr/bin/env python3
"""homelab-validate with every input in tools/validate/paths passed as one --path each, so a missing one fails.

Usage: tools/validate/homelab-validate [homelab-validate args...] [check...]
"""
import os
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
sys.path.insert(0, str(here))
import validate_paths  # noqa: E402

try:
    paths = validate_paths.load(here / "paths")
except (OSError, validate_paths.PathsError) as exc:
    sys.exit(f"tools/validate/homelab-validate: {exc}")
os.execvp("homelab-validate", ["homelab-validate", "--root", str(here.parents[1]), *paths, *sys.argv[1:]])
