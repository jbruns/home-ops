{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":enablePreCommit"
  ],
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "schedule": [
    "* 10-13 * * 5"
  ],
  "timezone": "America/Los_Angeles",
  "packageRules": [
    {
      "description": "Disable Docker-sourced updates for emby/embyserver (handled by custom manager)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "emby/embyserver"
      ],
      "enabled": false
    },
    {
      "description": "Disable Docker-sourced updates for portainer/portainer-ee (handled by custom manager)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "portainer/portainer-ee"
      ],
      "enabled": false
    },
    {
      "description": "Grafana logging stack",
      "matchPackageNames": [
        "grafana/grafana",
        "grafana/loki",
        "grafana/alloy"
      ],
      "groupName": "grafana stack"
    },
    {
      "description": "Prometheus and Alertmanager",
      "matchPackageNames": [
        "prom/prometheus",
        "prom/alertmanager"
      ],
      "groupName": "prometheus"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Automerge minor and digest updates for Info-tier Services",
      "matchPackageNames": [
        "ghcr.io/onedr0p/exportarr",
        "ghcr.io/jsclayton/prometheus-plex-exporter",
        "oliver006/redis_exporter",
        "nvidia/dcgm-exporter",
        "prom/node-exporter",
        "ghcr.io/google/cadvisor",
        "ghcr.io/connorgallopo/tracearr",
        "ollama/ollama"
      ],
      "matchUpdateTypes": [
        "minor",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge pinning of digests",
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "startup-order Custom Component on the Host: never automerge; after merging, install it on the Host (host/README.md)",
      "matchDatasources": [
        "github-release-attachments"
      ],
      "matchPackageNames": [
        "jbruns/homelab-components"
      ],
      "automerge": false,
      "prBodyNotes": [
        "After merging, install the new release on the Host: [runbook](https://github.com/jbruns/home-ops/blob/main/host/README.md#runbook-install-or-upgrade-startup-order)."
      ]
    }
  ],
  "docker-compose": {
    "description": "Also each Service's tn/<stack>/<service>/service.yaml; the defaults stay",
    "managerFilePatterns": [
      "/^tn/[^/]+/[^/]+/service\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Use GitHub Releases for emby/embyserver to filter out beta versions",
      "managerFilePatterns": [
        "/(^|/)(docker-)?compose\\.ya?ml$/",
        "/^tn/[^/]+/[^/]+/service\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*emby/embyserver:(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "MediaBrowser/Emby.Releases",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>[\\d.]+)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Use custom datasource for portainer-ee to only track LTS releases",
      "managerFilePatterns": [
        "/(^|/)(docker-)?compose\\.ya?ml$/",
        "/^tn/[^/]+/[^/]+/service\\.yaml$/"
      ],
      "matchStrings": [
        "image:\\s*portainer/portainer-ee:(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "portainer-ee",
      "datasourceTemplate": "custom.portainer-lts",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Versions annotated with # renovate: comments in workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+:\\s*\"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "startup-order release pinned for the Host: tag and the sha256 of its startup-order.sh asset",
      "managerFilePatterns": [
        "/^host/startup-order\\.pin$/"
      ],
      "matchStrings": [
        "STARTUP_ORDER_TAG=(?<currentValue>\\S+)\\s+STARTUP_ORDER_SHA256=(?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "jbruns/homelab-components",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^startup-order-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "customDatasources": {
    "portainer-lts": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/portainer/portainer/releases?per_page=100",
      "transformTemplates": [
        "{ \"releases\": $map($[$contains(name, \"LTS\")], function($v) { { \"version\": $v.tag_name, \"releaseTimestamp\": $v.published_at, \"sourceUrl\": \"https://github.com/portainer/portainer\", \"changelogUrl\": $v.html_url } }) }"
      ]
    }
  }
}
